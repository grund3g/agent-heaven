{
  "name": "agent-heaven",
  "version": "0.5.0",
  "private": true,
  "productName": "Agent Heaven",
  "description": "Electron UI that spawns Codex + Claude Code CLI agents as cards and streams output.",
  "license": "MIT",
  "engines": {
    "node": "22.x"
  },
  "main": "build/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postinstall": "node scripts/fix-node-pty-perms.js",
    "start": "npm run build && electron .",
    "dev": "node scripts/dev.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "chokidar": "^4.0.3",
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.0",
    "vitest": "^2.1.9"
  },
  "build": {
    "appId": "com.simonschnabl.agentheaven",
    "directories": {
      "buildResources": "build-res"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build-res/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "files": [
      "build/**/*",
      "renderer/**/*",
      "package.json"
    ]
  }
}
